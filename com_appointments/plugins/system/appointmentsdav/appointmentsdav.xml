<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_APPOINTMENTSDAV</name>
    <author>Advans IT Solutions GmbH</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Advans IT Solutions GmbH</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <version>1.0.0</version>
    <description>PLG_SYSTEM_APPOINTMENTSDAV_XML_DESCRIPTION</description>
    <namespace path="src">Advans\Plugin\System\AppointmentsDav</namespace>
    <files>
        <folder plugin="appointmentsdav">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename>LICENSE.txt</filename>
    </files>
    <languages folder="language">
        <language tag="en-GB">en-GB/plg_system_appointmentsdav.ini</language>
        <language tag="en-GB">en-GB/plg_system_appointmentsdav.sys.ini</language>
        <language tag="de-DE">de-DE/plg_system_appointmentsdav.ini</language>
        <language tag="de-DE">de-DE/plg_system_appointmentsdav.sys.ini</language>
        <language tag="fr-FR">fr-FR/plg_system_appointmentsdav.ini</language>
        <language tag="fr-FR">fr-FR/plg_system_appointmentsdav.sys.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="dav_base_url"
                    type="url"
                    label="PLG_SYSTEM_APPOINTMENTSDAV_FIELD_DAV_BASE_URL_LABEL"
                    description="PLG_SYSTEM_APPOINTMENTSDAV_FIELD_DAV_BASE_URL_DESC"
                    filter="url"
                    validate="url"
                    scheme="https"
                    default=""
                    hint="https://www.example.org/dav/"
                />
            </fieldset>
        </fields>
    </config>
</extension>
