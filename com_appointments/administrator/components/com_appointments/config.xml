<config addruleprefix="Advans\Component\Appointments\Administrator\Rule">
    <fieldset name="basic" label="COM_APPOINTMENTS_CONFIG_BASIC_LABEL">
        <field name="autoload_language" type="hidden" default="1" />
        <field name="consent_mode" type="list" label="COM_APPOINTMENTS_CONFIG_CONSENT_MODE" description="COM_APPOINTMENTS_CONFIG_CONSENT_MODE_DESC" default="notice" filter="cmd" validate="options">
            <option value="notice">COM_APPOINTMENTS_CONFIG_CONSENT_MODE_NOTICE</option>
            <option value="acknowledge">COM_APPOINTMENTS_CONFIG_CONSENT_MODE_ACKNOWLEDGE</option>
            <option value="consent">COM_APPOINTMENTS_CONFIG_CONSENT_MODE_CONSENT</option>
        </field>
        <field name="consent_text" type="textarea" label="COM_APPOINTMENTS_CONFIG_CONSENT" description="COM_APPOINTMENTS_CONFIG_CONSENT_DESC" filter="string" />
        <field name="privacy_menuitem" type="menuitem" label="COM_APPOINTMENTS_CONFIG_PRIVACY_MENUITEM" description="COM_APPOINTMENTS_CONFIG_PRIVACY_MENUITEM_DESC" filter="integer" client="site">
            <option value="">JNONE</option>
        </field>
        <field name="privacy_anchor" type="text" label="COM_APPOINTMENTS_CONFIG_PRIVACY_ANCHOR" description="COM_APPOINTMENTS_CONFIG_PRIVACY_ANCHOR_DESC" filter="cmd" maxlength="64" showon="privacy_menuitem!:" />
        <field name="privacy_url" type="url" label="COM_APPOINTMENTS_CONFIG_PRIVACY_URL" description="COM_APPOINTMENTS_CONFIG_PRIVACY_URL_DESC" filter="url" relative="true" />
        <field name="phone_default_country" type="text" label="COM_APPOINTMENTS_CONFIG_PHONE_COUNTRY" description="COM_APPOINTMENTS_CONFIG_PHONE_COUNTRY_DESC" filter="cmd" maxlength="3" pattern="[0-9]{0,3}" />
        <field name="phone_country_choice" type="radio" layout="joomla.form.field.radio.buttons" label="COM_APPOINTMENTS_CONFIG_PHONE_COUNTRY_CHOICE" description="COM_APPOINTMENTS_CONFIG_PHONE_COUNTRY_CHOICE_DESC" default="1" filter="integer" validate="options">
            <option value="0">COM_APPOINTMENTS_CONFIG_PHONE_COUNTRY_CHOICE_FIXED</option>
            <option value="1">COM_APPOINTMENTS_CONFIG_PHONE_COUNTRY_CHOICE_FREE</option>
        </field>
        <field name="max_guests" type="number" label="COM_APPOINTMENTS_CONFIG_MAX_GUESTS" description="COM_APPOINTMENTS_CONFIG_MAX_GUESTS_DESC" default="10" min="0" max="50" required="true" filter="raw" validate="range" />
        <field name="erase_mode" type="list" label="COM_APPOINTMENTS_CONFIG_ERASE_MODE" description="COM_APPOINTMENTS_CONFIG_ERASE_MODE_DESC" default="anonymise" filter="cmd" validate="options">
            <option value="anonymise">COM_APPOINTMENTS_CONFIG_ERASE_ANONYMISE</option>
            <option value="delete">COM_APPOINTMENTS_CONFIG_ERASE_DELETE</option>
        </field>
        <field name="reminder_offsets" type="text" label="COM_APPOINTMENTS_CONFIG_REMINDER_OFFSETS" description="COM_APPOINTMENTS_CONFIG_REMINDER_OFFSETS_DESC" default="1440,60" filter="string" />
        <field name="public_site_url" type="url" label="COM_APPOINTMENTS_CONFIG_PUBLIC_SITE_URL" description="COM_APPOINTMENTS_CONFIG_PUBLIC_SITE_URL_DESC" filter="url" />
        <field name="retention_tasks_note" type="note" description="COM_APPOINTMENTS_CONFIG_RETENTION_TASKS_DESC" class="alert alert-info" filter="unset" />
        <field name="retention_days" type="number" label="COM_APPOINTMENTS_CONFIG_RETENTION_DAYS" description="COM_APPOINTMENTS_CONFIG_RETENTION_DAYS_DESC" default="365" min="0" max="65535" required="true" filter="raw" validate="range" />
        <field name="audit_retention_years" type="number" label="COM_APPOINTMENTS_CONFIG_AUDIT_RETENTION" description="COM_APPOINTMENTS_CONFIG_AUDIT_RETENTION_DESC" default="3" min="1" max="100" required="true" filter="raw" validate="range" />
        <field name="removal_block_reason" type="textarea" label="COM_APPOINTMENTS_CONFIG_REMOVAL_BLOCK" description="COM_APPOINTMENTS_CONFIG_REMOVAL_BLOCK_DESC" filter="string" />
    </fieldset>
    <fieldset name="close" label="COM_APPOINTMENTS_CLOSE_TITLE">
        <field name="close_note" type="note" description="COM_APPOINTMENTS_CLOSE_NOTE" filter="unset" />
        <field name="close_enabled" type="radio" layout="joomla.form.field.radio.switcher" label="JENABLED" default="0" filter="integer" validate="options">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="close_profiles" type="subform" multiple="true" layout="joomla.form.field.subform.repeatable" max="20" label="COM_APPOINTMENTS_CLOSE_PROFILES" description="COM_APPOINTMENTS_CLOSE_PROFILES_DESC">
            <form>
                <field name="key" type="text" label="COM_APPOINTMENTS_CLOSE_PROFILE_KEY" description="COM_APPOINTMENTS_CLOSE_PROFILE_KEY_DESC" filter="cmd" maxlength="32" pattern="[a-z0-9][a-z0-9_\-]{0,31}" required="true" />
                <field name="eventtypes" type="sql" multiple="true" label="COM_APPOINTMENTS_CLOSE_PROFILE_EVENTTYPES" description="COM_APPOINTMENTS_CLOSE_PROFILE_EVENTTYPES_DESC" query="SELECT id AS value, title AS text FROM #__appointments_eventtypes ORDER BY title" key_field="value" value_field="text" filter="array" />
                <field name="origin" type="url" label="COM_APPOINTMENTS_CLOSE_ORIGIN" filter="url" />
                <field name="credential_env" type="text" label="COM_APPOINTMENTS_CLOSE_CREDENTIAL" description="COM_APPOINTMENTS_CLOSE_CREDENTIAL_DESC" filter="string" maxlength="101" />
                <field name="delivery" type="list" label="COM_APPOINTMENTS_CLOSE_DELIVERY" description="COM_APPOINTMENTS_CLOSE_DELIVERY_DESC" default="note" filter="cmd" validate="options">
                    <option value="note">COM_APPOINTMENTS_CLOSE_DELIVERY_NOTE</option>
                    <option value="activity">COM_APPOINTMENTS_CLOSE_DELIVERY_ACTIVITY</option>
                </field>
                <field name="activity_type" type="text" label="COM_APPOINTMENTS_CLOSE_TYPE" filter="string" maxlength="110" showon="delivery:activity" />
                <field name="activity_fields" type="textarea" label="COM_APPOINTMENTS_CLOSE_FIELDS" description="COM_APPOINTMENTS_CLOSE_FIELDS_DESC" filter="raw" showon="delivery:activity" />
                <field name="activity_answers" type="textarea" label="COM_APPOINTMENTS_CLOSE_ACTIVITY_ANSWERS" description="COM_APPOINTMENTS_CLOSE_ACTIVITY_ANSWERS_DESC" filter="raw" showon="delivery:activity" />
                <field name="note_answers" type="text" label="COM_APPOINTMENTS_CLOSE_NOTE_ANSWERS" description="COM_APPOINTMENTS_CLOSE_NOTE_ANSWERS_DESC" filter="string" maxlength="1000" />
                <field name="campaign" type="text" label="COM_APPOINTMENTS_CLOSE_CAMPAIGN" description="COM_APPOINTMENTS_CLOSE_CAMPAIGN_DESC" filter="string" maxlength="255" />
                <field name="source" type="text" label="COM_APPOINTMENTS_CLOSE_SOURCE" description="COM_APPOINTMENTS_CLOSE_SOURCE_DESC" filter="string" maxlength="255" />
                <field name="lead_name" type="text" label="COM_APPOINTMENTS_CLOSE_LEAD_NAME" description="COM_APPOINTMENTS_CLOSE_LEAD_NAME_DESC" filter="string" maxlength="1000" />
                <field name="contact_title" type="text" label="COM_APPOINTMENTS_CLOSE_CONTACT_TITLE" description="COM_APPOINTMENTS_CLOSE_CONTACT_TITLE_DESC" filter="string" maxlength="1000" />
                <field name="lead_answers" type="textarea" label="COM_APPOINTMENTS_CLOSE_LEAD_ANSWERS" description="COM_APPOINTMENTS_CLOSE_LEAD_ANSWERS_DESC" filter="raw" />
                <field name="lead_values" type="textarea" label="COM_APPOINTMENTS_CLOSE_LEAD_VALUES" description="COM_APPOINTMENTS_CLOSE_LEAD_VALUES_DESC" filter="raw" />
            </form>
        </field>
    </fieldset>
    <fieldset name="conference" label="COM_APPOINTMENTS_CONFERENCE_SETTINGS" addfieldprefix="Advans\Component\Appointments\Administrator\Field">
        <field name="conference_provider" type="Conferenceprovider" label="COM_APPOINTMENTS_EVENTTYPE_PROVIDER" default="none" filter="cmd" validate="options">
            <option value="none">JNONE</option>
            <option value="jitsi">COM_APPOINTMENTS_PROVIDER_JITSI</option>
            <option value="generic">COM_APPOINTMENTS_PROVIDER_GENERIC</option>
            <option value="fixed">COM_APPOINTMENTS_PROVIDER_FIXED</option>
        </field>
        <field name="conference_jitsi_base_url" type="url" label="COM_APPOINTMENTS_CONFERENCE_BASE_URL" filter="url" showon="conference_provider:jitsi" />
        <field name="conference_jitsi_room_pattern" type="text" label="COM_APPOINTMENTS_CONFERENCE_ROOM_PATTERN" description="COM_APPOINTMENTS_CONFERENCE_ROOM_PATTERN_DESC" default="{prefix}-{alias}-{random}" filter="string" showon="conference_provider:jitsi" />
        <field name="conference_jitsi_room_prefix" type="text" label="COM_APPOINTMENTS_CONFERENCE_ROOM_PREFIX" default="appointment" maxlength="64" filter="string" showon="conference_provider:jitsi" />
        <field name="conference_jitsi_entropy" type="number" label="COM_APPOINTMENTS_CONFERENCE_ENTROPY" description="COM_APPOINTMENTS_CONFERENCE_ENTROPY_DESC" default="24" min="16" max="64" required="true" filter="raw" validate="range" showon="conference_provider:jitsi" />
        <field name="conference_jitsi_auth" type="list" label="COM_APPOINTMENTS_CONFERENCE_AUTH" default="none" filter="cmd" validate="options" showon="conference_provider:jitsi">
            <option value="none">JNONE</option><option value="jwt">JWT</option>
        </field>
        <field name="conference_jitsi_jwt_secret" type="password" label="COM_APPOINTMENTS_CONFERENCE_JWT_SECRET" filter="raw" showon="conference_provider:jitsi[AND]conference_jitsi_auth:jwt" />
        <field name="conference_jitsi_jwt_app_id" type="text" label="COM_APPOINTMENTS_CONFERENCE_APP_ID" filter="string" showon="conference_provider:jitsi[AND]conference_jitsi_auth:jwt" />
        <field name="conference_jitsi_jwt_audience" type="text" label="COM_APPOINTMENTS_CONFERENCE_AUDIENCE" default="jitsi" filter="string" showon="conference_provider:jitsi[AND]conference_jitsi_auth:jwt" />
        <field name="conference_jitsi_jwt_issuer" type="text" label="COM_APPOINTMENTS_CONFERENCE_ISSUER" filter="string" showon="conference_provider:jitsi[AND]conference_jitsi_auth:jwt" />
        <field name="conference_jitsi_jwt_subject" type="text" label="COM_APPOINTMENTS_CONFERENCE_SUBJECT" filter="string" showon="conference_provider:jitsi[AND]conference_jitsi_auth:jwt" />
        <field name="conference_jitsi_host_lead_minutes" type="number" label="COM_APPOINTMENTS_CONFERENCE_HOST_LEAD" default="30" min="0" max="1440" required="true" filter="raw" validate="range" showon="conference_provider:jitsi[AND]conference_jitsi_auth:jwt" />
        <field name="conference_jitsi_grace_minutes" type="number" label="COM_APPOINTMENTS_CONFERENCE_GRACE" default="60" min="0" max="1440" required="true" filter="raw" validate="range" showon="conference_provider:jitsi[AND]conference_jitsi_auth:jwt" />
        <field name="conference_generic_template" type="text" label="COM_APPOINTMENTS_CONFERENCE_GENERIC_URL" description="COM_APPOINTMENTS_CONFERENCE_GENERIC_DESC" filter="string" showon="conference_provider:generic" />
        <field name="conference_fixed_url" type="url" label="COM_APPOINTMENTS_CONFERENCE_FIXED_URL" filter="url" showon="conference_provider:fixed" />
        <field name="fixed_warning" type="note" description="COM_APPOINTMENTS_CONFERENCE_FIXED_WARNING" class="alert alert-warning" showon="conference_provider:fixed" />
        <field name="conference_allow_outbound" type="radio" layout="joomla.form.field.radio.switcher" label="COM_APPOINTMENTS_CONFERENCE_ALLOW_OUTBOUND" description="COM_APPOINTMENTS_CONFERENCE_ALLOW_OUTBOUND_DESC" default="0" filter="integer" validate="options">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
    </fieldset>
    <fieldset name="teamcalendars" label="COM_APPOINTMENTS_CONFIG_TEAM">
        <field name="teamcal_enabled" type="radio" layout="joomla.form.field.radio.switcher" label="COM_APPOINTMENTS_CONFIG_TEAM_ENABLED" description="COM_APPOINTMENTS_CONFIG_TEAM_ENABLED_DESC" default="0" filter="integer" validate="options">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="team_groups" type="usergrouplist" label="COM_APPOINTMENTS_CONFIG_TEAM_GROUPS" description="COM_APPOINTMENTS_CONFIG_TEAM_GROUPS_DESC" multiple="true" layout="joomla.form.field.list-fancy-select" filter="intarray" />
        <field name="external_group" type="usergrouplist" label="COM_APPOINTMENTS_CONFIG_EXTERNAL_GROUP" description="COM_APPOINTMENTS_CONFIG_EXTERNAL_GROUP_DESC" filter="integer">
            <option value="">JNONE</option>
        </field>
        <field name="booking_data_migration" type="hidden" filter="raw" />
        <field name="team_create_groups" type="radio" layout="joomla.form.field.radio.switcher" label="COM_APPOINTMENTS_CONFIG_TEAM_CREATE_GROUPS" description="COM_APPOINTMENTS_CONFIG_TEAM_CREATE_GROUPS_DESC" default="1" filter="integer" validate="options">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
        <field name="team_viewlevel" type="accesslevel" label="COM_APPOINTMENTS_CONFIG_TEAM_VIEWLEVEL" description="COM_APPOINTMENTS_CONFIG_TEAM_VIEWLEVEL_DESC" filter="integer" />
        <field name="team_cleanup_days" type="number" label="COM_APPOINTMENTS_CONFIG_CLEANUP_DAYS" description="COM_APPOINTMENTS_CONFIG_CLEANUP_DAYS_DESC" default="14" min="1" max="90" required="true" filter="raw" validate="range" />
        <field name="legacy_feeds" type="radio" layout="joomla.form.field.radio.switcher" label="COM_APPOINTMENTS_CONFIG_LEGACY_FEEDS" description="COM_APPOINTMENTS_CONFIG_LEGACY_FEEDS_DESC" default="0" filter="integer" validate="options">
            <option value="0">JNO</option><option value="1">JYES</option>
        </field>
    </fieldset>
    <fieldset name="help" label="COM_APPOINTMENTS_HELP_TITLE">
        <field name="help_note" type="note" description="COM_APPOINTMENTS_HELP_CONFIG_DESC" class="alert alert-info" filter="unset" />
    </fieldset>
    <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL" description="JCONFIG_PERMISSIONS_DESC">
        <field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" class="inputbox" validate="rules" filter="rules" component="com_appointments" section="component" />
    </fieldset>
    <fieldset name="data-lifecycle" label="COM_APPOINTMENTS_CONFIG_UNINSTALL">
        <field name="uninstall_data_action" type="list" label="COM_APPOINTMENTS_CONFIG_UNINSTALL_ACTION" description="COM_APPOINTMENTS_CONFIG_UNINSTALL_ACTION_DESC" default="" filter="cmd" validate="options">
            <option value="">COM_APPOINTMENTS_CONFIG_UNINSTALL_ACTION_UNSET</option>
            <option value="keep">COM_APPOINTMENTS_CONFIG_UNINSTALL_ACTION_KEEP</option>
            <option value="delete">COM_APPOINTMENTS_CONFIG_UNINSTALL_ACTION_DELETE</option>
        </field>
    </fieldset>
</config>
