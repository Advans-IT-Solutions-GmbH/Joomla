# Test Configuration for J2Commerce - Product Compare Plugin
# CONTAINER_NAME can be overridden by the CI environment (e.g. for J6 stack)
CONTAINER_NAME="plg_j2commerce_productcompare_test"
EXTENSION_NAME="J2Commerce - Product Compare Plugin"

# The installer registers folder=j2store on Joomla 5 (J2Store 4) and keeps
# folder=j2commerce on Joomla 6; shared suites look the plugin up in both.
INSTALLED_PLUGIN_FOLDERS="j2commerce,j2store"

# Test scripts to run (format: "TestName:script-file.php")
# TestName must match workflow matrix script names
TEST_SCRIPTS=(
    "installation:01-installation.php"
    "configuration:02-configuration.php"
    "media:03-media-files.php"
    "plugin-class:04-plugin-class.php"
    "ajax:05-ajax-endpoint.php"
    "getproductsdata:07-getproductsdata.php"
    "asset-injection:08-asset-injection.php"
    "render-injection:09-render-injection.php"
    "event-dispatch:10-event-dispatch.php"
    "shop-detection:11-active-shop-detection.php"
    "page-render:12-page-render.php"
    "install-messages:shared-install-messages.php"
    "uninstall:06-uninstall.php"
)
