<form addfieldprefix="Advans\Component\Appointments\Administrator\Field">
    <fieldset name="details">
        <field name="id" type="hidden" filter="integer" />
        <field name="eventtype_id" type="Eventscope" sitewide="true" label="COM_APPOINTMENTS_TEMPLATE_SCOPE" description="COM_APPOINTMENTS_TEMPLATE_SCOPE_DESC" required="true" filter="integer">
            <option value="">JSELECT</option>
        </field>
        <field name="purpose" type="list" label="COM_APPOINTMENTS_TEMPLATE_PURPOSE" required="true">
            <option value="">JSELECT</option>
            <option value="confirmation">COM_APPOINTMENTS_TEMPLATE_PURPOSE_CONFIRMATION</option>
            <option value="pending">COM_APPOINTMENTS_TEMPLATE_PURPOSE_PENDING</option>
            <option value="approved">COM_APPOINTMENTS_TEMPLATE_PURPOSE_APPROVED</option>
            <option value="reschedule">COM_APPOINTMENTS_TEMPLATE_PURPOSE_RESCHEDULE</option>
            <option value="cancellation">COM_APPOINTMENTS_TEMPLATE_PURPOSE_CANCELLATION</option>
            <option value="reminder">COM_APPOINTMENTS_TEMPLATE_PURPOSE_REMINDER</option>
            <option value="host_notice">COM_APPOINTMENTS_TEMPLATE_PURPOSE_HOST_NOTICE</option>
            <option value="host_approved">COM_APPOINTMENTS_TEMPLATE_PURPOSE_HOST_APPROVED</option>
            <option value="host_reschedule">COM_APPOINTMENTS_TEMPLATE_PURPOSE_HOST_RESCHEDULE</option>
            <option value="host_cancellation">COM_APPOINTMENTS_TEMPLATE_PURPOSE_HOST_CANCELLATION</option>
            <option value="host_reminder">COM_APPOINTMENTS_TEMPLATE_PURPOSE_HOST_REMINDER</option>
            <option value="erasure_notice">COM_APPOINTMENTS_TEMPLATE_PURPOSE_ERASURE_NOTICE</option>
            <option value="guest_confirmation">COM_APPOINTMENTS_TEMPLATE_PURPOSE_GUEST_CONFIRMATION</option>
            <option value="guest_pending">COM_APPOINTMENTS_TEMPLATE_PURPOSE_GUEST_PENDING</option>
            <option value="guest_approved">COM_APPOINTMENTS_TEMPLATE_PURPOSE_GUEST_APPROVED</option>
            <option value="guest_reschedule">COM_APPOINTMENTS_TEMPLATE_PURPOSE_GUEST_RESCHEDULE</option>
            <option value="guest_cancellation">COM_APPOINTMENTS_TEMPLATE_PURPOSE_GUEST_CANCELLATION</option>
            <option value="guest_reminder">COM_APPOINTMENTS_TEMPLATE_PURPOSE_GUEST_REMINDER</option>
            <option value="team_device_added">COM_APPOINTMENTS_TEMPLATE_PURPOSE_TEAM_DEVICE_ADDED</option>
            <option value="team_invitation">COM_APPOINTMENTS_TEMPLATE_PURPOSE_TEAM_INVITATION</option>
            <option value="team_invitation_accepted">COM_APPOINTMENTS_TEMPLATE_PURPOSE_TEAM_INVITATION_ACCEPTED</option>
            <option value="team_grant_changed">COM_APPOINTMENTS_TEMPLATE_PURPOSE_TEAM_GRANT_CHANGED</option>
            <option value="team_access_suspended">COM_APPOINTMENTS_TEMPLATE_PURPOSE_TEAM_ACCESS_SUSPENDED</option>
            <option value="team_calendar_deleted">COM_APPOINTMENTS_TEMPLATE_PURPOSE_TEAM_CALENDAR_DELETED</option>
            <option value="team_account_locked">COM_APPOINTMENTS_TEMPLATE_PURPOSE_TEAM_ACCOUNT_LOCKED</option>
        </field>
        <field name="language" type="text" label="JFIELD_LANGUAGE_LABEL" description="COM_APPOINTMENTS_TEMPLATE_LANGUAGE_DESC" required="true" maxlength="7" />
        <field name="subject" type="text" label="COM_APPOINTMENTS_TEMPLATE_SUBJECT" required="true" maxlength="255" filter="raw" />
        <field name="body" type="textarea" label="COM_APPOINTMENTS_TEMPLATE_BODY" description="COM_APPOINTMENTS_TEMPLATE_BODY_DESC" required="true" rows="18" filter="raw" />
    </fieldset>
    <fieldset name="state">
        <field name="published" type="list" label="JSTATUS" default="1" filter="integer">
            <option value="1">JPUBLISHED</option>
            <option value="0">JUNPUBLISHED</option>
        </field>
    </fieldset>
</form>
