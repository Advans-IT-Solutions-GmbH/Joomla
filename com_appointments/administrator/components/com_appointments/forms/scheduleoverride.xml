<?xml version="1.0" encoding="utf-8"?>
<!--
    A date-specific override. It replaces the weekday's intervals for that date
    entirely rather than adding to them, which is what makes a holiday or a
    single different day easy to express.

    The date is a plain local date in the schedule's own time zone, so the
    calendar field deliberately carries no time and no time-zone conversion:
    converting it to UTC could move it to the day before or after.

    That takes `filter="none"` rather than no filter attribute at all. Joomla's
    calendar field defaults its *display* filter to `user_utc` when the
    attribute is missing, so a stored 2026-12-24 was read as midnight UTC and
    shown to an operator west of UTC as the 23rd, which they would then save.
    The save itself did not convert, because the output filter is read straight
    from the attribute, and that asymmetry is what moved the date one day
    earlier on every round trip. Any value other than `server_utc` or
    `user_utc` turns both conversions off.
-->
<form>
    <fieldset>
        <field
            name="specific_date"
            type="calendar"
            label="COM_APPOINTMENTS_OVERRIDE_FIELD_DATE"
            format="%Y-%m-%d"
            showtime="false"
            filter="none"
            size="12"
        />

        <field
            name="is_unavailable"
            type="list"
            label="COM_APPOINTMENTS_OVERRIDE_FIELD_CLOSED"
            default="0"
            validate="options"
        >
            <option value="0">COM_APPOINTMENTS_OVERRIDE_OPEN</option>
            <option value="1">COM_APPOINTMENTS_OVERRIDE_CLOSED</option>
        </field>

        <field
            name="start_time"
            type="text"
            label="COM_APPOINTMENTS_RULE_FIELD_START"
            hint="09:00"
            size="6"
            pattern="[0-9]{1,2}:[0-9]{2}"
        />

        <field
            name="end_time"
            type="text"
            label="COM_APPOINTMENTS_RULE_FIELD_END"
            hint="17:00"
            size="6"
            pattern="[0-9]{1,2}:[0-9]{2}"
        />
    </fieldset>
</form>
