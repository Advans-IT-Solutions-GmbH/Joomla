<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_APPOINTMENTS</name>
    <element>com_appointments</element>
    <author>Advans IT Solutions GmbH</author>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 Advans IT Solutions GmbH</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <authorEmail>info@advans.ch</authorEmail>
    <authorUrl>https://advans.ch</authorUrl>
    <version>1.0.0</version>
    <description>COM_APPOINTMENTS_XML_DESCRIPTION</description>

    <targetplatform name="joomla" version="(5\.[4-9]|6\.[0-9])" />
    <php_minimum>8.1</php_minimum>

    <namespace path="src">Advans\Component\Appointments</namespace>
    <scriptfile>script.php</scriptfile>
    <plugins>
        <plugin group="task" element="appointments" folder="plugins/task/appointments" />
    </plugins>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <files folder="components/com_appointments">
        <folder>services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <filename>index.html</filename>
        <filename>LICENSE.txt</filename>
    </files>

    <languages folder="language">
        <language tag="en-GB">en-GB/com_appointments.ini</language>
        <language tag="de-DE">de-DE/com_appointments.ini</language>
        <language tag="fr-FR">fr-FR/com_appointments.ini</language>
    </languages>

    <media destination="com_appointments" folder="media/com_appointments">
        <folder>css</folder>
        <filename>index.html</filename>
        <filename>joomla.asset.json</filename>
    </media>

    <administration>
        <menu link="option=com_appointments">COM_APPOINTMENTS</menu>
        <files folder="administrator/components/com_appointments">
            <folder>forms</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <filename>access.xml</filename>
            <filename>index.html</filename>
            <filename>LICENSE.txt</filename>
        </files>

        <languages folder="administrator/language">
            <language tag="en-GB">en-GB/com_appointments.ini</language>
            <language tag="en-GB">en-GB/com_appointments.sys.ini</language>
            <language tag="de-DE">de-DE/com_appointments.ini</language>
            <language tag="de-DE">de-DE/com_appointments.sys.ini</language>
            <language tag="fr-FR">fr-FR/com_appointments.ini</language>
            <language tag="fr-FR">fr-FR/com_appointments.sys.ini</language>
        </languages>
    </administration>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="autoload_language"
                    type="hidden"
                    default="1"
                />
                <field name="consent_text" type="textarea" label="COM_APPOINTMENTS_CONFIG_CONSENT" description="COM_APPOINTMENTS_CONFIG_CONSENT_DESC" filter="string" />
                <field name="privacy_url" type="url" label="COM_APPOINTMENTS_CONFIG_PRIVACY_URL" filter="url" relative="true" />
                <field name="erase_mode" type="list" label="COM_APPOINTMENTS_CONFIG_ERASE_MODE" description="COM_APPOINTMENTS_CONFIG_ERASE_MODE_DESC" default="anonymise" filter="cmd">
                    <option value="anonymise">COM_APPOINTMENTS_CONFIG_ERASE_ANONYMISE</option>
                    <option value="delete">COM_APPOINTMENTS_CONFIG_ERASE_DELETE</option>
                </field>
                <field name="reminder_offsets" type="text" label="COM_APPOINTMENTS_CONFIG_REMINDER_OFFSETS" description="COM_APPOINTMENTS_CONFIG_REMINDER_OFFSETS_DESC" default="1440,60" filter="string" />
                <field name="public_site_url" type="url" label="COM_APPOINTMENTS_CONFIG_PUBLIC_SITE_URL" description="COM_APPOINTMENTS_CONFIG_PUBLIC_SITE_URL_DESC" filter="url" />
                <field name="retention_days" type="number" label="COM_APPOINTMENTS_CONFIG_RETENTION_DAYS" description="COM_APPOINTMENTS_CONFIG_RETENTION_DAYS_DESC" default="365" min="0" max="65535" required="true" filter="integer" />
                <field name="audit_retention_years" type="number" label="COM_APPOINTMENTS_CONFIG_AUDIT_RETENTION" description="COM_APPOINTMENTS_CONFIG_AUDIT_RETENTION_DESC" default="3" min="1" max="100" required="true" filter="integer" />
            </fieldset>

            <fieldset
                name="permissions"
                label="JCONFIG_PERMISSIONS_LABEL"
                description="JCONFIG_PERMISSIONS_DESC"
            >
                <field
                    name="rules"
                    type="rules"
                    label="JCONFIG_PERMISSIONS_LABEL"
                    class="inputbox"
                    validate="rules"
                    filter="rules"
                    component="com_appointments"
                    section="component"
                />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="Appointments Updates">
            https://raw.githubusercontent.com/Advans-IT-Solutions-GmbH/Joomla/main/com_appointments/updates/update.xml
        </server>
    </updateservers>
</extension>
