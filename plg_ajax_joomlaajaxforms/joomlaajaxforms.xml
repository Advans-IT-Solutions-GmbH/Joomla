<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="ajax" method="upgrade">
    <name>PLG_AJAX_JOOMLAAJAXFORMS</name>
    <author>Advans IT Solutions GmbH</author>
    <authorEmail>info@advans.ch</authorEmail>
    <authorUrl>https://advans.ch</authorUrl>
    <copyright>(C) 2026 Advans IT Solutions GmbH</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <creationDate>2026-11</creationDate>
    <version>1.8.0</version>
    <description>PLG_AJAX_JOOMLAAJAXFORMS_DESC</description>
    <scriptfile>script.php</scriptfile>
    <namespace path="src">Advans\Plugin\Ajax\JoomlaAjaxForms</namespace>

    <files>
        <folder plugin="joomlaajaxforms">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <filename>LICENSE.txt</filename>
    </files>

    <media destination="plg_ajax_joomlaajaxforms" folder="media">
        <folder>js</folder>
    </media>

    <languages>
        <language tag="en-GB">language/en-GB/plg_ajax_joomlaajaxforms.ini</language>
        <language tag="en-GB">language/en-GB/plg_ajax_joomlaajaxforms.sys.ini</language>
        <language tag="de-DE">language/de-DE/plg_ajax_joomlaajaxforms.ini</language>
        <language tag="de-DE">language/de-DE/plg_ajax_joomlaajaxforms.sys.ini</language>
        <language tag="fr-FR">language/fr-FR/plg_ajax_joomlaajaxforms.ini</language>
        <language tag="fr-FR">language/fr-FR/plg_ajax_joomlaajaxforms.sys.ini</language>
    </languages>

    <config>
        <fields name="params" addfieldprefix="Advans\Plugin\Ajax\JoomlaAjaxForms\Field">
            <fieldset name="basic">
                <field name="help_note" type="note" class="alert alert-info" description="PLG_AJAX_JOOMLAAJAXFORMS_HELP_NOTE"/>
                <field
                    name="enable_login"
                    type="radio"
                    label="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_LOGIN"
                    description="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_LOGIN_DESC"
                    default="1"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="enable_registration"
                    type="radio"
                    label="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_REGISTRATION"
                    description="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_REGISTRATION_DESC"
                    default="1"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="enable_reset"
                    type="radio"
                    label="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_RESET"
                    description="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_RESET_DESC"
                    default="1"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="enable_remind"
                    type="radio"
                    label="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_REMIND"
                    description="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_REMIND_DESC"
                    default="1"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="enable_profile"
                    type="radio"
                    label="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_PROFILE"
                    description="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_PROFILE_DESC"
                    default="1"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="enable_j2store_cart"
                    type="radio"
                    label="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_J2STORE_CART"
                    description="PLG_AJAX_JOOMLAAJAXFORMS_ENABLE_J2STORE_CART_DESC"
                    default="1"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
                <field
                    name="debug"
                    type="radio"
                    label="PLG_AJAX_JOOMLAAJAXFORMS_DEBUG"
                    description="PLG_AJAX_JOOMLAAJAXFORMS_DEBUG_DESC"
                    default="0"
                    class="btn-group btn-group-yesno">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>
            </fieldset>
            <fieldset name="help" label="PLG_AJAX_JOOMLAAJAXFORMS_HELP_TAB">
                <field name="helppage" type="helppage" hiddenLabel="true">
                    <section title="PLG_AJAX_JOOMLAAJAXFORMS_HELP_WHAT_TITLE">
                        <p>PLG_AJAX_JOOMLAAJAXFORMS_HELP_WHAT_P1</p>
                        <ul>
