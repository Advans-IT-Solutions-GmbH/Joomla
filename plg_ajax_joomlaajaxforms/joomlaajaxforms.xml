                        <ul>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SETTINGS_LI1</li>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SETTINGS_LI2</li>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SETTINGS_LI3</li>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SETTINGS_LI4</li>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SETTINGS_LI5</li>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SETTINGS_LI6</li>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SETTINGS_LI7</li>
                        </ul>
