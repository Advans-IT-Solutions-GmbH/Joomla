# Test configuration for the Appointments component.
#
# CONTAINER_NAME names the Joomla 5.4 lane (docker-compose.yml). The Joomla 6
# lane (docker-compose.joomla6.yml) is driven by passing
# CONTAINER_NAME=com_appointments_j6_test on the command line, the same way the
# other extensions of this repository do it.
CONTAINER_NAME="com_appointments_test"
EXTENSION_NAME="Appointments Component"

# Test scripts to run (format: "TestName:script-file.php").
# TestName must match the workflow matrix script names.
TEST_SCRIPTS=(
    "installation:01-installation.php"
    "structure:02-structure.php"
    "backend-views:shared-backend-views.php"
    "install-messages:shared-install-messages.php"
    "uninstall:20-uninstall.php"
)
