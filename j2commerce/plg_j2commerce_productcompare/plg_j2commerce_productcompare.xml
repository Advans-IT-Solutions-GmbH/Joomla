<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="j2commerce" method="upgrade">
    <autoloadLanguage>true</autoloadLanguage>
    <scriptfile>script.php</scriptfile>
    <name>PLG_J2COMMERCE_PRODUCTCOMPARE</name>
    <element>productcompare</element>
    <author>Advans IT Solutions GmbH</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Advans IT Solutions GmbH</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <authorEmail>info@advans.ch</authorEmail>
    <authorUrl>https://advans.ch</authorUrl>
    <version>1.3.1</version>
    <description>PLG_J2COMMERCE_PRODUCTCOMPARE_XML_DESCRIPTION</description>
    
    <targetplatform name="joomla" version="(5\.[4-9]|6\.[0-9])" />
    <php_minimum>8.1</php_minimum>

    <namespace path="src">Advans\Plugin\J2Commerce\ProductCompare</namespace>

    <files>
        <folder plugin="productcompare">services</folder>
        <folder>src</folder>
        <folder>language</folder>
        <folder>tmpl</folder>
        <folder>media</folder>
        <filename>LICENSE.txt</filename>
    </files>

    <media destination="plg_j2commerce_productcompare" folder="media">
        <folder>js</folder>
        <folder>css</folder>
        <filename>joomla.asset.json</filename>
    </media>

    <config>
        <fields name="params" addfieldprefix="Advans\Plugin\J2Commerce\ProductCompare\Field">
            <fieldset name="basic">
                <field name="help_note" type="note" class="alert alert-info" description="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_NOTE"/>
                <field
                    name="show_in_list"
                    type="radio"
                    label="PLG_J2COMMERCE_PRODUCTCOMPARE_SHOW_IN_LIST_LABEL"
                    description="PLG_J2COMMERCE_PRODUCTCOMPARE_SHOW_IN_LIST_DESC"
                    default="1"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="show_in_detail"
                    type="radio"
                    label="PLG_J2COMMERCE_PRODUCTCOMPARE_SHOW_IN_DETAIL_LABEL"
                    description="PLG_J2COMMERCE_PRODUCTCOMPARE_SHOW_IN_DETAIL_DESC"
                    default="1"
                    class="btn-group btn-group-yesno"
                >
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="max_products"
                    type="number"
                    label="PLG_J2COMMERCE_PRODUCTCOMPARE_MAX_PRODUCTS_LABEL"
                    description="PLG_J2COMMERCE_PRODUCTCOMPARE_MAX_PRODUCTS_DESC"
                    default="4"
                    min="2"
                    max="10"
                    step="1"
                />

                <field
                    name="button_text"
                    type="text"
                    label="PLG_J2COMMERCE_PRODUCTCOMPARE_BUTTON_TEXT_LABEL"
                    description="PLG_J2COMMERCE_PRODUCTCOMPARE_BUTTON_TEXT_DESC"
                    default="PLG_J2COMMERCE_PRODUCTCOMPARE_DEFAULT_BUTTON_TEXT"
                />

                <field
                    name="button_class"
                    type="text"
                    label="PLG_J2COMMERCE_PRODUCTCOMPARE_BUTTON_CLASS_LABEL"
                    description="PLG_J2COMMERCE_PRODUCTCOMPARE_BUTTON_CLASS_DESC"
                    default="btn btn-secondary"
                />
            </fieldset>
            <fieldset name="help" label="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_TAB">
                <field name="helppage" type="helppage" hiddenLabel="true">
                    <section title="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_WHAT_TITLE">
                        <p>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_WHAT_P1</p>
                        <ul>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_WHAT_LI1</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_WHAT_LI2</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_WHAT_LI3</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_WHAT_LI4</li>
                        </ul>
                        <note>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_WHAT_NOTE</note>
                    </section>
                    <section title="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETUP_TITLE">
                        <ol>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETUP_STEP1</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETUP_STEP2</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETUP_STEP3</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETUP_STEP4</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETUP_STEP5</li>
                        </ol>
                        <note>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETUP_NOTE</note>
                    </section>
                    <section title="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_INSTALL_TITLE">
                        <ul>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_INSTALL_LI1</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_INSTALL_LI2</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_INSTALL_LI3</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_INSTALL_LI4</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_INSTALL_LI5</li>
                        </ul>
                    </section>
                    <section title="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETTINGS_TITLE">
                        <p>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETTINGS_P1</p>
                        <ul>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETTINGS_LI1</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETTINGS_LI2</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETTINGS_LI3</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETTINGS_LI4</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_SETTINGS_LI5</li>
                        </ul>
                    </section>
                    <section title="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PERMS_TITLE">
                        <ul>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PERMS_LI1</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PERMS_LI2</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PERMS_LI3</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PERMS_LI4</li>
                        </ul>
                    </section>
                    <section title="PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PROBLEMS_TITLE">
                        <ul>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PROBLEMS_LI1</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PROBLEMS_LI2</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PROBLEMS_LI3</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PROBLEMS_LI4</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PROBLEMS_LI5</li>
                            <li>PLG_J2COMMERCE_PRODUCTCOMPARE_HELP_PROBLEMS_LI6</li>
                        </ul>
                    </section>
                </field>
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="J2Store Product Compare">
            https://raw.githubusercontent.com/Advans-IT-Solutions-GmbH/Joomla/main/j2commerce/plg_j2commerce_productcompare/updates/update.xml
        </server>
    </updateservers>
</extension>
