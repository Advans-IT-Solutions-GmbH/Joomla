<form addfieldprefix="Advans\Component\Appointments\Administrator\Field">
    <fields name="filter">
        <field name="search" type="text" inputmode="search" label="COM_APPOINTMENTS_FILTER_SEARCH_LABEL" hint="COM_APPOINTMENTS_BOOKINGS_FILTER_SEARCH_HINT" maxlength="200" />
        <field name="eventtype_id" type="Eventscope" label="COM_APPOINTMENTS_FIELD_EVENTTYPE" onchange="this.form.submit();">
            <option value="">COM_APPOINTMENTS_FILTER_SELECT_EVENTTYPE</option>
        </field>
        <field name="state" type="list" label="JSTATUS" onchange="this.form.submit();">
            <option value="">JOPTION_SELECT_PUBLISHED</option>
            <option value="0">COM_APPOINTMENTS_BOOKINGS_PENDING</option>
            <option value="1">COM_APPOINTMENTS_BOOKINGS_CONFIRMED</option>
            <option value="2">COM_APPOINTMENTS_BOOKINGS_CANCELLED</option>
        </field>
        <field name="from" type="calendar" label="COM_APPOINTMENTS_BOOKINGS_FROM" hint="COM_APPOINTMENTS_BOOKINGS_FROM" format="%Y-%m-%d" filterformat="Y-m-d" showtime="false" translateformat="false" filter="none" onchange="this.form.submit();" />
        <field name="to" type="calendar" label="COM_APPOINTMENTS_BOOKINGS_TO" hint="COM_APPOINTMENTS_BOOKINGS_TO" format="%Y-%m-%d" filterformat="Y-m-d" showtime="false" translateformat="false" filter="none" onchange="this.form.submit();" />
    </fields>
    <fields name="list">
        <field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="b.start_utc DESC" onchange="this.form.submit();" validate="options">
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="b.start_utc DESC">COM_APPOINTMENTS_BOOKINGS_ORDER_START_DESC</option>
            <option value="b.start_utc ASC">COM_APPOINTMENTS_BOOKINGS_ORDER_START_ASC</option>
            <option value="b.invitee_last_name ASC">COM_APPOINTMENTS_BOOKINGS_ORDER_NAME_ASC</option>
            <option value="b.invitee_last_name DESC">COM_APPOINTMENTS_BOOKINGS_ORDER_NAME_DESC</option>
            <option value="e.title ASC">COM_APPOINTMENTS_SORT_EVENTTYPE_ASC</option>
            <option value="e.title DESC">COM_APPOINTMENTS_SORT_EVENTTYPE_DESC</option>
            <option value="b.state ASC">JSTATUS_ASC</option>
            <option value="b.state DESC">JSTATUS_DESC</option>
            <option value="b.id ASC">JGRID_HEADING_ID_ASC</option>
            <option value="b.id DESC">JGRID_HEADING_ID_DESC</option>
        </field>
        <field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="25" onchange="this.form.submit();" />
    </fields>
</form>
