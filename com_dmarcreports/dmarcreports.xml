<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_DMARCREPORTS</name>
    <element>com_dmarcreports</element>
    <author>Advans IT Solutions GmbH</author>
    <creationDate>2026-10</creationDate>
    <copyright>(C) 2026 Advans IT Solutions GmbH</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <authorEmail>info@advans.ch</authorEmail>
    <authorUrl>https://advans.ch</authorUrl>
    <version>1.1.3</version>
    <description>COM_DMARCREPORTS_XML_DESCRIPTION</description>

    <targetplatform name="joomla" version="(5\.[4-9]|6\.[0-9])" />
    <php_minimum>8.1</php_minimum>

    <namespace path="src">Advans\Component\DmarcReports</namespace>
    <scriptfile>script.php</scriptfile>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>

    <administration>
        <menu link="option=com_dmarcreports">COM_DMARCREPORTS</menu>
        <files folder="administrator/components/com_dmarcreports">
            <folder>forms</folder>
            <folder>services</folder>
            <folder>sql</folder>
            <folder>src</folder>
            <folder>tmpl</folder>
            <filename>access.xml</filename>
            <filename>config.xml</filename>
            <filename>index.html</filename>
            <filename>LICENSE.txt</filename>
        </files>

        <languages folder="administrator/language">
            <language tag="en-GB">en-GB/com_dmarcreports.ini</language>
            <language tag="en-GB">en-GB/com_dmarcreports.sys.ini</language>
            <language tag="de-DE">de-DE/com_dmarcreports.ini</language>
            <language tag="de-DE">de-DE/com_dmarcreports.sys.ini</language>
            <language tag="fr-FR">fr-FR/com_dmarcreports.ini</language>
            <language tag="fr-FR">fr-FR/com_dmarcreports.sys.ini</language>
        </languages>
    </administration>

    <updateservers>
        <server type="extension" priority="1" name="DMARC Reports Updates">
            https://raw.githubusercontent.com/Advans-IT-Solutions-GmbH/Joomla/main/com_dmarcreports/updates/update.xml
        </server>
    </updateservers>
</extension>
