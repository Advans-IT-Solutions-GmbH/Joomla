# Build Configuration for the J2Commerce Privacy Package
EXTENSION_NAME="pkg_privacy_j2commerce"
VERSION="1.9.1"
EXTENSION_TYPE="package"
# Tag prefix of the releases (<prefix>-vX.Y.Z); the build hashes the files of every earlier release.
# The package continues the release line of the standalone privacy plugin, so the prefix is unchanged.
RELEASE_PREFIX="privacy"
