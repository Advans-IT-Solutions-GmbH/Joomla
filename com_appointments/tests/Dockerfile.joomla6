# Moving tag: newest Joomla 6.x release on the newest PHP of the official image.
FROM joomla:6-php8.4-apache

RUN apt-get update && apt-get install -y \
    unzip \
    curl \
    default-mysql-client \
    libzip-dev \
    && docker-php-ext-install zip \
    && rm -rf /var/lib/apt/lists/*

RUN echo "[client]\nskip-ssl" > /etc/mysql/conf.d/no-ssl.cnf

COPY extension.zip /tmp/extension.zip

COPY scripts/docker-entrypoint.sh /usr/local/bin/custom-entrypoint.sh
RUN chmod +x /usr/local/bin/custom-entrypoint.sh

ENV EXTENSION_NAME="Appointments Component (J6)"

ENTRYPOINT ["/usr/local/bin/custom-entrypoint.sh"]
CMD ["apache2-foreground"]
