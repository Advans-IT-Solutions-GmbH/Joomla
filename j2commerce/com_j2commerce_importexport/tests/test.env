# Test Configuration for J2Commerce Import/Export Component
CONTAINER_NAME="com_j2commerce_importexport_test"
EXTENSION_NAME="J2Commerce Import/Export Component"

# Extra backend addresses shared-backend-views.php has to render besides the
# views it finds on disk. The component has exactly one view (dashboard);
# import and export are controller tasks, and both names must answer with the
# dashboard instead of Joomla's "View not found".
BACKEND_VIEWS_EXTRA="import,export"

# Test scripts to run (format: "TestName:script-file.php")
# TestName must match workflow matrix script names
TEST_SCRIPTS=(
    "installation:01-installation.php"
    "structure:02-component-structure.php"
    "export-model:03-export-model.php"
    "import-model:04-import-model.php"
    "roundtrip:04b-roundtrip.php"
    "export-controller:05-export-controller.php"
    "export-http:07-export-http.php"
    "import-http:08-import-http.php"
    "active-shop:09-active-shop-detection.php"
    "backend-views:shared-backend-views.php"
    "install-messages:shared-install-messages.php"
    "uninstall:06-uninstall.php"
)

