                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SECURITY_LI6</li>
                        </ul>
                    </section>
                    <section title="PLG_AJAX_JOOMLAAJAXFORMS_HELP_PROBLEMS_TITLE">
                        <ul>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_PROBLEMS_LI1</li>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_PROBLEMS_LI2</li>
