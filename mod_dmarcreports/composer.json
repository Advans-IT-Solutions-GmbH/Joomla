{
    "name": "advans/mod-dmarcreports",
    "description": "DMARC Reports dashboard administrator module for Joomla",
    "type": "joomla-module",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "joomla/registry": "^4.0",
        "phpunit/phpunit": "^13.4"
    },
    "scripts": {
        "build": "./build.sh",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
