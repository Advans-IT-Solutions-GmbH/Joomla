<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="osmap" method="upgrade">
    <name>PLG_OSMAP_J2COMMERCE</name>
    <element>j2commerce</element>
    <author>Advans IT Solutions GmbH</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Advans IT Solutions GmbH</copyright>
    <license>GNU General Public License version 3 or later; see LICENSE.txt</license>
    <authorEmail>info@advans.ch</authorEmail>
    <authorUrl>https://advans.ch</authorUrl>
    <version>1.5.1</version>
    <description>PLG_OSMAP_J2COMMERCE_XML_DESCRIPTION</description>

    <targetplatform name="joomla" version="(5\.[4-9]|6\.[0-9])" />
    <php_minimum>8.1</php_minimum>

    <scriptfile>script.php</scriptfile>

    <namespace path="src">Advans\Plugin\Osmap\J2Commerce</namespace>
    <autoloadLanguage>true</autoloadLanguage>

    <files>
        <filename plugin="j2commerce">j2commerce.php</filename>
        <filename>LICENSE.txt</filename>
        <folder>services</folder>
        <folder>src</folder>
        <folder>language</folder>
    </files>

    <config>
        <fields name="params" addfieldprefix="Advans\Plugin\Osmap\J2Commerce\Field">
            <fieldset name="basic">
                <field name="help_note" type="note" class="alert alert-info" description="PLG_OSMAP_J2COMMERCE_HELP_NOTE"/>
                <field
                    name="priority"
                    type="list"
                    default="0.8"
                    label="PLG_OSMAP_PRIORITY_LABEL"
                    description="PLG_OSMAP_PRIORITY_DESC">
                    <option value="0.0">0.0</option>
                    <option value="0.1">0.1</option>
                    <option value="0.2">0.2</option>
                    <option value="0.3">0.3</option>
                    <option value="0.4">0.4</option>
                    <option value="0.5">0.5</option>
                    <option value="0.6">0.6</option>
                    <option value="0.7">0.7</option>
                    <option value="0.8">0.8</option>
                    <option value="0.9">0.9</option>
                    <option value="1.0">1.0</option>
                </field>
                <field
                    name="changefreq"
                    type="list"
                    default="weekly"
                    label="PLG_OSMAP_CHANGEFREQ_LABEL"
                    description="PLG_OSMAP_CHANGEFREQ_DESC">
                    <option value="always">always</option>
                    <option value="hourly">hourly</option>
                    <option value="daily">daily</option>
                    <option value="weekly">weekly</option>
                    <option value="monthly">monthly</option>
                    <option value="yearly">yearly</option>
                    <option value="never">never</option>
                </field>
            </fieldset>
            <fieldset name="help" label="PLG_OSMAP_J2COMMERCE_HELP_TAB">
                <field name="helppage" type="helppage" hiddenLabel="true">
                    <section title="PLG_OSMAP_J2COMMERCE_HELP_WHAT_TITLE">
                        <p>PLG_OSMAP_J2COMMERCE_HELP_WHAT_P1</p>
                        <p>PLG_OSMAP_J2COMMERCE_HELP_WHAT_P2</p>
                        <ul>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_WHAT_LI1</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_WHAT_LI2</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_WHAT_LI3</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_WHAT_LI4</li>
                        </ul>
                        <note>PLG_OSMAP_J2COMMERCE_HELP_WHAT_NOTE</note>
                    </section>
                    <section title="PLG_OSMAP_J2COMMERCE_HELP_SETUP_TITLE">
                        <ol>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETUP_STEP1</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETUP_STEP2</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETUP_STEP3</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETUP_STEP4</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETUP_STEP5</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETUP_STEP6</li>
                        </ol>
                    </section>
                    <section title="PLG_OSMAP_J2COMMERCE_HELP_CONTENT_TITLE">
                        <p>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_P1</p>
                        <ul>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_LI1</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_LI2</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_LI3</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_LI4</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_LI5</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_LI6</li>
                        </ul>
                        <note>PLG_OSMAP_J2COMMERCE_HELP_CONTENT_NOTE</note>
                    </section>
                    <section title="PLG_OSMAP_J2COMMERCE_HELP_SETTINGS_TITLE">
                        <p>PLG_OSMAP_J2COMMERCE_HELP_SETTINGS_P1</p>
                        <ul>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETTINGS_LI1</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_SETTINGS_LI2</li>
                        </ul>
                        <note>PLG_OSMAP_J2COMMERCE_HELP_SETTINGS_NOTE</note>
                    </section>
                    <section title="PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_TITLE">
                        <ul>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_LI1</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_LI2</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_LI3</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_LI4</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_LI5</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_LI6</li>
                            <li>PLG_OSMAP_J2COMMERCE_HELP_PROBLEMS_LI7</li>
                        </ul>
                    </section>
                </field>
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="OSMap J2Commerce">
            https://raw.githubusercontent.com/Advans-IT-Solutions-GmbH/Joomla/main/j2commerce/plg_osmap_j2commerce/updates/update.xml
        </server>
    </updateservers>
</extension>
