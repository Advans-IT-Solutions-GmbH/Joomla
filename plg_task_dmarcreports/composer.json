{
    "name": "advans/plg-task-dmarcreports",
    "description": "Scheduler task plugin for automatic DMARC and TLS-RPT ingestion",
    "type": "joomla-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "build": "./build.sh",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
