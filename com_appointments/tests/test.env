# Test configuration for the Appointments component.
#
# CONTAINER_NAME names the Joomla 5.4 lane (docker-compose.yml). The other two
# lanes are driven by passing their container on the command line, the same way
# the other extensions of this repository do it:
#   docker-compose.joomla6.yml  -> CONTAINER_NAME=com_appointments_j6_test
#   docker-compose.mariadb.yml  -> CONTAINER_NAME=com_appointments_mariadb_test
# The MariaDB lane exists because the booking table uses an indexed STORED
# generated column, and it runs the schema-sensitive suites only.
CONTAINER_NAME="com_appointments_test"
EXTENSION_NAME="Appointments Component"

# Test scripts to run (format: "TestName:script-file.php").
# TestName must match the workflow matrix script names.
TEST_SCRIPTS=(
    "installation:01-installation.php"
    "structure:02-structure.php"
    "site-page:03-site-page.php"
    "schedules:04-schedules.php"
    "blocked:05-blocked.php"
    "eventtypes:06-eventtypes.php"
    "booking:08-booking.php"
    "mail:09-mail.php"
    "templates:09-template-admin.php"
    "lifecycle:10-lifecycle.php"
    "erasure:11-erasure.php"
    "scheduler:12-scheduler.php"
    "feed:12-feed.php"
    "backend-views:shared-backend-views.php"
    "install-messages:shared-install-messages.php"
    "uninstall:20-uninstall.php"
)
