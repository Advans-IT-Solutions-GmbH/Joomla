                    </section>
                    <section title="PLG_AJAX_JOOMLAAJAXFORMS_HELP_SECURITY_TITLE">
                        <ul>
                            <li>PLG_AJAX_JOOMLAAJAXFORMS_HELP_SECURITY_LI1</li>
